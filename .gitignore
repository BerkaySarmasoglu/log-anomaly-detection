# Raw and intermediate data (never committed)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Model artifacts (large binaries, not versioned)
outputs/models/*
!outputs/models/.gitkeep

# Virtual environment
venv/
.venv/
env/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS
.DS_Store

# Editor
.vscode/
.idea/